#!/bin/sh
# Proyecto Almanaque: GitHub Flow. Nada de push directo a main, y ramas con
# nombre <tipo>/<NNN>-<slug> o <tipo>/<slug>. Reglas: docs/github-flow.md.
export LC_ALL=C.UTF-8

zero=0000000000000000000000000000000000000000
pattern='^(feat|fix|docs|refactor|test|perf|chore|build|ci)/[a-z0-9]+(-[a-z0-9]+)*$'
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/*) branch=${remote_ref#refs/heads/} ;;
    *) continue ;;
  esac
  if [ "$branch" = "main" ]; then
    echo "Error: no se hace push directo a main. Abrí un Pull Request desde una rama (docs/github-flow.md)." >&2
    status=1
  elif [ "$local_sha" != "$zero" ] && ! printf '%s\n' "$branch" | grep -Eq "$pattern"; then
    {
      echo "Error: la rama «$branch» no sigue el formato <tipo>/<NNN>-<slug>."
      echo "  Ejemplo: feat/049-low-volume-days · Tipos: feat, fix, docs, refactor, test, perf, chore, build, ci"
    } >&2
    status=1
  fi
done

exit $status
